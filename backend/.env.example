# Template for local environment variables.
# Copy this file to '.env' and fill in your actual Render URL and FACE_API_KEY.

# The URL of your deployed website on Render (or custom domain)
REMOTE_API_URL=https://your-custom-domain.com

# The secret API key generated by Render under your service Environment settings
FACE_API_KEY=your-copied-api-key-from-render
